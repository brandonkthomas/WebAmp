<section class="wa-view wa-view--home" data-wa-view="home" aria-label="Home">
    <h1 class="wa-h1 wa-sr-only">Home</h1>

    <div class="wa-grid wa-grid--quick" data-wa-home-browse>
        <a class="wa-card wa-card--link" href="/webamp/search" data-wa-nav="search">
            <h3 class="wa-h3 wa-homequick__title">
                <img class="wa-homequick__icon" src="~/apps/indium/assets/svg/search-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                <span>Search</span>
            </h3>
            <p class="wa-copy wa-homequick__caption">Find tracks, artists, albums, and playlists.</p>
        </a>
        <a class="wa-card wa-card--link" href="/webamp/playlists" data-wa-nav="playlist">
            <h3 class="wa-h3 wa-homequick__title">
                <img class="wa-homequick__icon" src="~/apps/indium/assets/svg/playlist-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                <span>Playlists</span>
            </h3>
            <p class="wa-copy wa-homequick__caption">Browse your playlists.</p>
        </a>
        <a class="wa-card wa-card--link" href="/webamp/albums" data-wa-nav="album">
            <h3 class="wa-h3 wa-homequick__title">
                <img class="wa-homequick__icon" src="~/apps/indium/assets/svg/album-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                <span>Albums</span>
            </h3>
            <p class="wa-copy wa-homequick__caption">Browse your saved albums.</p>
        </a>
        <a class="wa-card wa-card--link" href="/webamp/liked" data-wa-nav="liked">
            <h3 class="wa-h3 wa-homequick__title" data-wa-liked-heading>
                <img class="wa-homequick__icon" src="~/apps/indium/assets/svg/heart-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                <span data-wa-liked-heading-text>Liked Songs</span>
            </h3>
            <p class="wa-copy wa-homequick__caption">Browse your liked tracks.</p>
        </a>
    </div>

    <div class="wa-card wa-card--glass" data-wa-home-recent-card>
        <h2 class="wa-h2">Recent</h2>
        <div class="wa-list" data-wa-home-recent aria-label="Recent items"></div>
    </div>

    <div class="wa-grid wa-grid--2">
        <div class="wa-card wa-card--glass">
            <h2 class="wa-h2 wa-h2--link" data-wa-nav-href="/webamp/playlists">Your Playlists</h2>
            <div class="wa-copy" data-wa-playlists-status></div>
            <div class="wa-list" data-wa-playlists aria-label="Your playlists"></div>
        </div>
        <div class="wa-card wa-card--glass">
            <h2 class="wa-h2 wa-h2--link" data-wa-liked-heading data-wa-nav-href="/webamp/liked">
                <span data-wa-liked-heading-text>Liked Songs</span>
            </h2>
            <div class="wa-copy" data-wa-liked-status></div>
            <div class="wa-list" data-wa-liked aria-label="Liked songs"></div>
        </div>
    </div>
</section>
