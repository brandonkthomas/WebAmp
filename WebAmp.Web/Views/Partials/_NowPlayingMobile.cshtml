<div class="wa-nowplaying" data-wa-nowplaying aria-hidden="true">
    <div class="wa-nowplaying__backdrop" data-wa-nowplaying-close aria-hidden="true"></div>

    <section class="wa-nowplaying__sheet" role="dialog" aria-label="Now playing" aria-modal="true">
        <button type="button" class="wa-nowplaying__grab" data-wa-nowplaying-grab aria-label="Close now playing">
            <span class="wa-nowplaying__grab-handle" aria-hidden="true"></span>
        </button>

        <div class="wa-nowplaying__content">
            <div class="wa-nowplaying__art" aria-hidden="true">
                <img class="wa-nowplaying__art-img" data-wa-nowplaying-art alt="" />
            </div>

            <div class="wa-nowplaying__meta">
                <div class="wa-nowplaying__title" data-wa-nowplaying-title>Not Playing</div>
                <div class="wa-nowplaying__artist" data-wa-nowplaying-artist>—</div>
            </div>

            <div class="wa-nowplaying__scrub" aria-label="Seek">
                <input
                    class="wa-nowplaying__range"
                    data-wa-nowplaying-scrubber
                    type="range"
                    min="0"
                    max="100"
                    step="0.1"
                    value="0"
                    aria-label="Scrubber" />
                <div class="wa-nowplaying__times">
                    <span class="wa-nowplaying__time" data-wa-nowplaying-time-current>0:00</span>
                    <span class="wa-nowplaying__time" data-wa-nowplaying-time-duration>0:00</span>
                </div>
            </div>

            <div class="wa-nowplaying__controls" aria-label="Playback controls">
                <button type="button" class="wa-nowplaying__btn wa-nowplaying__btn--prev" data-wa-nowplaying-prev aria-label="Previous track">
                    <img class="wa-nowplaying__icon" src="~/apps/webamp/assets/svg/previous-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                </button>
                <button type="button" class="wa-nowplaying__btn wa-nowplaying__btn--play" data-wa-nowplaying-toggle aria-label="Play/Pause">
                    <img class="wa-nowplaying__icon wa-nowplaying__icon--playpause" data-wa-nowplaying-toggle-icon src="~/apps/webamp/assets/svg/play-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                </button>
                <button type="button" class="wa-nowplaying__btn wa-nowplaying__btn--next" data-wa-nowplaying-next aria-label="Next track">
                    <img class="wa-nowplaying__icon" src="~/apps/webamp/assets/svg/next-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                </button>
            </div>

            <div class="wa-nowplaying__bottom">
                <label class="comp-toggle comp-toggle--topbar comp-toggle--nowplaying" aria-label="Shuffle">
                    <input type="checkbox" class="comp-toggle-input" data-wa-nowplaying-shuffle />
                    <span class="comp-toggle-track comp-toggle-large" aria-hidden="true">
                        <span class="comp-toggle-thumb">
                            <img src="~/apps/webamp/assets/svg/shuffle-filled.svg" asp-append-version="true" alt="" aria-hidden="true" />
                        </span>
                    </span>
                </label>
            </div>
        </div>
    </section>
</div>

