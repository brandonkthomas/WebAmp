<section class="wa-view wa-view--landing" data-wa-view="landing" aria-label="Landing">
    <div class="wa-landing">
        <div class="wa-landing__bg gnc-container" aria-hidden="true">
            <canvas id="gnc"></canvas>
        </div>

        <div class="wa-landing__brand" aria-label="WebAmp">
            <div class="wa-landing__logo" aria-hidden="true">
                <img class="wa-landing__logo-img" src="~/apps/webamp/assets/icons/icon-WebAmp-full512.png" asp-append-version="true" alt="" />
            </div>
            <div class="wa-landing__name">WebAmp</div>
            <div class="wa-landing__description">Music player webapp</div>
        </div>

        <div class="glass-surface glass-surface--fallback wa-landing__signin-surface">
            <div class="glass-surface__content wa-landing__signin-surface-content">
                <div class="wa-landing__signin" aria-label="Sign in">
                    <div class="wa-landing__signin-label">SIGN IN</div>
                    <button type="button" class="wa-landing__spotify" data-wa-action="spotify-connect" aria-label="Sign in with Spotify">
                        <span class="wa-landing__provider-icon" aria-hidden="true">
                            <img src="~/apps/webamp/assets/svg/spotify.svg" asp-append-version="true" alt="" />
                        </span>
                        <span class="wa-landing__provider-label">Spotify</span>
                    </button>
                    <button type="button" class="wa-landing__soundcloud" data-wa-action="soundcloud-enter" aria-label="Continue with SoundCloud">
                        <span class="wa-landing__provider-icon" aria-hidden="true">
                            <img src="~/apps/webamp/assets/svg/soundcloud.svg" asp-append-version="true" alt="" />
                        </span>
                        <span class="wa-landing__provider-label">SoundCloud</span>
                    </button>
                    @* <div class="wa-landing__status" data-wa-landing-status>Not connected</div>
                    <button type="button" class="wa-btn" data-wa-action="continue" disabled>
                        Continue
                    </button> *@
                </div>
            </div>
        </div>
    </div>
</section>
