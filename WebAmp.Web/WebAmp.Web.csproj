<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- Serve module static assets under /apps/webamp/* when referenced by a host app -->
    <StaticWebAssetBasePath>apps/webamp</StaticWebAssetBasePath>

    <!-- Version injected by host build/push script (defaults to dev for local builds). -->
    <WebAmpAppVersion Condition="'$(WebAmpAppVersion)' == ''">dev</WebAmpAppVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Build client JS from TS (do not commit generated JS) -->
  <Target Name="BuildWebAmpClient" BeforeTargets="Build">
    <PropertyGroup>
      <_WebAmpClientTs>$(MSBuildProjectDirectory)/wwwroot/ts/webamp.ts</_WebAmpClientTs>
      <_WebAmpOutDir>$(MSBuildProjectDirectory)/wwwroot/dist/js</_WebAmpOutDir>
      <_WebAmpOutFile>$(_WebAmpOutDir)/webamp.js</_WebAmpOutFile>
      <!-- Candidate esbuild locations for local dev repo layout(s). -->
      <_EsbuildCliPortfolio>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../Portfolio/node_modules/esbuild/bin/esbuild'))</_EsbuildCliPortfolio>
      <_EsbuildCliDefault>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../node_modules/esbuild/bin/esbuild'))</_EsbuildCliDefault>
    </PropertyGroup>

    <MakeDir Directories="$(_WebAmpOutDir)" />

    <PropertyGroup>
      <_PortfolioTsPath Condition="'$(_PortfolioTsPath)' == ''">$(MSBuildProjectDirectory)/../../../Portfolio/wwwroot/ts</_PortfolioTsPath>
    </PropertyGroup>
    <Exec
      Condition="Exists('$(_WebAmpClientTs)')"
      Command="ESBUILD=&quot;$(EsbuildCli)&quot;; if [ -z &quot;$ESBUILD&quot; ]; then if [ -x &quot;$(_EsbuildCliPortfolio)&quot; ]; then ESBUILD=&quot;$(_EsbuildCliPortfolio)&quot;; else ESBUILD=&quot;$(_EsbuildCliDefault)&quot;; fi; fi; &quot;$ESBUILD&quot; &quot;$(_WebAmpClientTs)&quot; --bundle --format=esm --outfile=&quot;$(_WebAmpOutFile)&quot; --log-level=warning --resolve-extensions=.ts,.js --define:__WEBAMP_APP_VERSION__=&quot;\&quot;$(WebAmpAppVersion)\&quot;&quot;" />
  </Target>

</Project>
